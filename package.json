{
  "name": "my-vpns",
  "productName": "My VPNs",
  "desktopName": "my-vpns",
  "private": true,
  "version": "1.1.3",
  "description": "Gerenciador gráfico para conexões OpenFortiVPN",
  "author": {
    "name": "LucasCavalheri",
    "email": "LucasCavalheri@users.noreply.github.com"
  },
  "homepage": "https://github.com/LucasCavalheri/my-vpns",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasCavalheri/my-vpns.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:bundle && electron-builder --publish never",
    "build:deb": "tsc -b && vite build && electron-builder --linux deb --publish never",
    "build:rpm": "tsc -b && vite build && electron-builder --linux rpm --publish never",
    "build:dir": "npm run build:bundle && electron-builder --dir --publish never",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bundle": "tsc -b && vite build",
    "build:win": "npm run build:bundle && electron-builder --win nsis --x64 --publish never",
    "build:mac": "npm run build:bundle && electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "dev.cavallheri.myvpns",
    "productName": "My VPNs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Network",
      "executableName": "my-vpns",
      "syncDesktopName": true,
      "maintainer": "LucasCavalheri <LucasCavalheri@users.noreply.github.com>",
      "icon": "build/icon.png",
      "synopsis": "Gerenciador gráfico OpenFortiVPN",
      "description": "Conecte e monitore VPNs OpenFortiVPN (FortiGate SSL) com interface gráfica, tray e notificações.",
      "desktop": {
        "entry": {
          "Name": "My VPNs",
          "Comment": "Gerenciador OpenFortiVPN",
          "Categories": "Network;Security;",
          "StartupWMClass": "my-vpns"
        }
      },
      "extraResources": [
        {
          "from": "packaging/run-vpn.sh",
          "to": "helpers/run-vpn.sh"
        },
        {
          "from": "packaging/stop-vpn.sh",
          "to": "helpers/stop-vpn.sh"
        },
        {
          "from": "packaging/polkit",
          "to": "polkit",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "packaging/my-vpns-archive-keyring.asc",
          "to": "my-vpns-archive-keyring.asc"
        }
      ]
    },
    "deb": {
      "depends": [
        "pkexec | policykit-1",
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4"
      ],
      "recommends": [
        "openfortivpn"
      ],
      "afterInstall": "packaging/after-install.sh",
      "afterRemove": "packaging/after-remove.sh"
    },
    "rpm": {
      "depends": [
        "polkit",
        "gtk3",
        "libnotify"
      ],
      "afterInstall": "packaging/after-install.sh",
      "afterRemove": "packaging/after-remove.sh"
    },
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "packaging/macos-vpn.sh",
          "to": "helpers/macos-vpn.sh"
        }
      ],
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "extraResources": [
        {
          "from": "packaging/windows-vpn.ps1",
          "to": "helpers/windows-vpn.ps1"
        },
        {
          "from": "packaging/windows-network.ps1",
          "to": "helpers/windows-network.ps1"
        },
        {
          "from": "packaging/vpnc-script-win.js",
          "to": "helpers/vpnc-script-win.js"
        }
      ],
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
